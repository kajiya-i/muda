# Docker Compose の PostgreSQL の設定
POSTGRES_USER=muda
POSTGRES_PASSWORD=muda
POSTGRES_DB=muda
POSTGRES_PORT=5432

# バックエンドが接続するデータベースの URL
DATABASE_URL=postgres://muda:muda@localhost:5432/muda?sslmode=disable

# goose（マイグレーション）の設定。backend/ から実行する
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://muda:muda@localhost:5432/muda?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations